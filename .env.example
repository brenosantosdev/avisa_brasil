# Copie para .env (que NÃO vai para o Git) ou defina como variáveis de ambiente.
# Toda integração sem a sua variável fica desligada automaticamente.

# ANA HidroWebService
ANA_USUARIO=
ANA_SENHA=

# ntfy.sh (notificação push). Use um nome difícil de adivinhar: quem souber o tópico lê e publica.
NTFY_TOPICO=
# Opcional: outro servidor ntfy (padrão https://ntfy.sh)
NTFY_SERVIDOR=

# Telegram Bot API (token dado pelo @BotFather)
TELEGRAM_BOT_TOKEN=

# Twilio (só envio de SMS). Na conta trial, só para números verificados.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número do Twilio que envia (formato +15551234567)
TWILIO_FROM=
# Quem recebe, separados por vírgula (formato +5592999999999)
TWILIO_DESTINOS=

# Chave do sensor: se definida, o simulador e o ESP32 precisam mandar no cabeçalho X-API-Key
SENSOR_API_KEY=

# Senha do Painel da Defesa Civil (sem ela, o painel fica trancado)
PAINEL_SENHA=

# Banco (apenas para os profiles postgres e oracle)
DB_URL=
DB_USUARIO=
DB_SENHA=
